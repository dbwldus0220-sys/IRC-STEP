+def interpolate_commands_from_pose(commands, start_pose, interpolation_factor: float):
+    """Interpolate from an explicit joint pose to each command target."""
+    return [
+        (
+            column,
+            topic,
+            source,
+            start_pose[column]
+            + interpolation_factor * (target - start_pose[column]),
+        )
+        for column, topic, source, target in commands
+    ]
