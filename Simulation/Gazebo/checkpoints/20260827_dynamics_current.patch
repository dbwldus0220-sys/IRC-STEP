+class GazeboSimulationClock:
+    """Observe simulation time from a proven dynamic-pose subscription path."""
+
+    def __init__(self, topic):
+        try:
+            # Import Pose explicitly so gz.transport can deserialize nested
+            # gz.msgs.Pose entries in Pose_V reliably.
+            from gz.msgs10.pose_pb2 import Pose as _Pose  # noqa: F401
+            from gz.msgs10.pose_v_pb2 import Pose_V
+            from gz.transport13 import Node
+        except ImportError as error:
+            raise RuntimeError(
+                "Gazebo Python transport bindings are required for the "
+                "simulation-time ramp: gz.transport13 and gz.msgs10"
+            ) from error
+
+        self.lock = threading.Lock()
+        self.latest_time = None
+        self.message_count = 0
+        self.node = Node()
+        if not self.node.subscribe(Pose_V, topic, self._on_pose):
+            raise RuntimeError(
+                f"Failed to subscribe to Gazebo simulation-time topic: {topic}"
+            )
+
+    def _on_pose(self, message):
+        stamp = message.header.stamp
+        simulation_time = float(stamp.sec) + float(stamp.nsec) * 1e-9
+        with self.lock:
+            self.latest_time = simulation_time
+            self.message_count += 1
+
+    def snapshot(self):
+        with self.lock:
+            return self.latest_time, self.message_count
+
