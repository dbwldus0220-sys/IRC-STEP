+class SimulationRampTimer:
+    """Start at the first observed simulation-time advance."""
+
+    def __init__(self):
+        self.reference_time = None
+        self.start_time = None
+
+    def update(self, simulation_time):
+        if simulation_time is None:
+            return 0.0, False
+        if self.reference_time is None or simulation_time < self.reference_time:
+            self.reference_time = simulation_time
+            self.start_time = None
+            return 0.0, False
+        if self.start_time is None:
+            if simulation_time <= self.reference_time + 1e-12:
+                return 0.0, False
+            self.start_time = simulation_time
+            return 0.0, True
+        return max(0.0, simulation_time - self.start_time), False
+
