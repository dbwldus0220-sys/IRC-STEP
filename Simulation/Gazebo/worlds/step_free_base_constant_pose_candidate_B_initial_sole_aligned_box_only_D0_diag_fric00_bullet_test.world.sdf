<?xml version="1.0" ?>
<sdf version="1.11">
  <world name="step_constant_pose_candidate_B_initial_sole_aligned_box_only_D0_diag_fric00_bullet_test">
    <gui fullscreen="0">
      <camera name="front_camera">
        <pose>2.0 0 1.0 0 0.15 3.14159</pose>
        <view_controller>orbit</view_controller>
      </camera>
    </gui>

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <dart>
        <collision_detector>bullet</collision_detector>
      </dart>
    </physics>

    <plugin
      filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics">
    </plugin>

    <plugin
      filename="gz-sim-user-commands-system"
      name="gz::sim::systems::UserCommands">
    </plugin>

    <plugin
      filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster">
    </plugin>

    <!--
      Contact publishers are created on the first simulation update. When the
      GUI starts paused, execute one step before checking them with gz topic -i.
    -->
    <plugin
      filename="gz-sim-contact-system"
      name="gz::sim::systems::Contact">
    </plugin>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>10 10</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>10 10</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <include>
      <uri>model://step_urdf/step_free_base_constant_pose_candidate_B_initial_sole_aligned_box_only_D0_diag_fric00_test.sdf</uri>
      <!-- Candidate B: the lowest actual 15 mm sole-box surface corner is at ground z=0. -->
      <pose>0 0 0.383992559010058 0 0 0</pose>
    </include>
  </world>
</sdf>
